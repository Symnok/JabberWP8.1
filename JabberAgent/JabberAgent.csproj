  <ItemGroup>
    <!--
      Core and the account store are LINKED from the app project, not referenced as a
      DLL. One copy of the source, compiled into both, which sidesteps the
      cross-project dependency trouble WP8.1 has with agents - the same problem your
      GoogleContactSyncWP worked around by duplicating its logic by hand.

      HttpUploadService is deliberately left out: the agent never uploads anything.
    -->
    <Compile Include="..\JabberWP\Core\Jid.cs">
      <Link>Core\Jid.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Core\UploadSlot.cs">
      <Link>Core\UploadSlot.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Core\Xmpp.cs">
      <Link>Core\Xmpp.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Core\XmppAccount.cs">
      <Link>Core\XmppAccount.cs</Link>
    </Compile>
