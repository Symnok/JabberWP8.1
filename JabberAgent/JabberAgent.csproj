      <Link>Core\XmppConnection.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Core\XmppMessage.cs">
      <Link>Core\XmppMessage.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Core\XmppStreamParser.cs">
      <Link>Core\XmppStreamParser.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Services\MessageStore.cs">
      <Link>Services\MessageStore.cs</Link>
    </Compile>
    <Compile Include="..\JabberWP\Services\SessionHeartbeat.cs">
      <Link>Services\SessionHeartbeat.cs</Link>
