<Application
    x:Class="JabberWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:converters="clr-namespace:JabberWP.Converters">

    <Application.Resources>
        <converters:OutgoingToAlignmentConverter x:Key="OutgoingToAlignment"/>
        <converters:OutgoingToBrushConverter x:Key="OutgoingToBrush"/>
        <converters:PresenceToBrushConverter x:Key="PresenceToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Application.Resources>

    <Application.ApplicationLifetimeObjects>
        <shell:PhoneApplicationService
            Launching="Application_Launching"
            Closing="Application_Closing"
            Activated="Application_Activated"
            Deactivated="Application_Deactivated"/>
    </Application.ApplicationLifetimeObjects>
</Application>
