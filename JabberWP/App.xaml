<Application
    x:Class="JabberWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:JabberWP.Converters"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <converters:OutgoingToAlignmentConverter x:Key="OutgoingToAlignment"/>
            <converters:OutgoingToBrushConverter x:Key="OutgoingToBrush"/>
            <converters:PresenceToBrushConverter x:Key="PresenceToBrush"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Margin" Value="19,0,0,0"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource PhoneAccentBrush}"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,12,0,0"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Opacity" Value="0.7"/>
            </Style>

            <!-- Text entry across the app. The platform default is small on a
                 high-DPI phone screen. -->
            <Style x:Key="InputTextStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="22"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
