<Page
    x:Class="JabberWP.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="19,12,19,12">
            <TextBlock Text="JABBER" Style="{ThemeResource TitleTextBlockStyle}"
                       Margin="0,0,0,0" Opacity="0.6"/>
            <TextBlock Text="account" FontSize="34" Margin="0,-4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="19,0,19,0">
            <StackPanel>
                <TextBlock Text="jabber id" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="jid_tbx"
                         FontSize="22"
                         InputScope="EmailSmtpAddress"
                         PlaceholderText="you@example.com"/>

                <TextBlock Text="password" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox x:Name="password_pbx" FontSize="22"/>

                <TextBlock Text="server (leave empty to use the domain)"
                           Style="{StaticResource FieldLabelStyle}"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="host_tbx" FontSize="22" InputScope="Url"/>

                <TextBlock Text="port" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="port_tbx" FontSize="22" InputScope="Number" Text="5222"/>

                <TextBlock x:Name="error_tblck"
                           Margin="4,16,0,0"
                           FontSize="18"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource PhoneAccentBrush}"/>

                <ProgressBar x:Name="busy_pgb"
                             Margin="0,16,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>

                <Button x:Name="connect_btn"
                        Content="connect"
                        HorizontalAlignment="Stretch"
                        Margin="0,20,0,0"
                        Click="Connect_Click"/>

                <TextBlock Margin="4,24,0,24"
                           TextWrapping="Wrap"
                           Opacity="0.6"
                           Text="The connection uses STARTTLS and SASL PLAIN. Messages are not encrypted end to end."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
