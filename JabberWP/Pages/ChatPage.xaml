<Page
    x:Class="JabberWP.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="19,12,19,8">
            <TextBlock x:Name="name_tblck" FontSize="34"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="presence_tblck" FontSize="18" Opacity="0.6"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <ListView x:Name="messages_lstv"
                  Grid.Row="1"
                  Margin="7,0,7,0"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Tapping a bubble opens its link, if it has one. Background
                         must be set or the tap only registers over the glyphs. -->
                    <Border Margin="4,4,4,4"
                            Padding="10,7,10,7"
                            MaxWidth="330"
                            Background="{Binding IsOutgoing,
                                Converter={StaticResource OutgoingToBrush}}"
                            HorizontalAlignment="{Binding IsOutgoing,
                                Converter={StaticResource OutgoingToAlignment}}"
                            Tapped="Bubble_Tapped">
                        <StackPanel>
                            <!-- A message that is nothing but an image link renders
                                 as the picture. WinRT fetches and caches it from the
                                 bound Uri, so there is no separate prefetch. -->
                            <Image Source="{Binding ImageUri}"
                                   MaxHeight="260"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding IsImage,
                                       Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding Body}"
                                       FontSize="21"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsText,
                                           Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="tap to open"
                                       FontSize="14"
                                       Opacity="0.7"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasUrl,
                                           Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="14"
                                       Opacity="0.6"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="status_tblck"
                   Grid.Row="2"
                   Margin="11,0,11,4"
                   FontSize="16"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="3" Margin="7,4,7,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--
              Both buttons act on the POINTER PRESS, wired up in the constructor with
              AddHandler(handledEventsToo: true) - ButtonBase marks PointerPressed
              handled in its class handler, so a handler declared here would never
              run at all.
              Why the press and not Click: tapping a Button moves focus off the
              TextBox, which hides the on-screen keyboard and un-shifts the page, so
              the button slides out from under the finger before the pointer is
              released and Click never fires. Acting on the press beats the reflow.
              Click is still wired as a fallback; sending twice is harmless because
              the text box is cleared first.
            -->
            <Button x:Name="attach_btn"
                    Grid.Column="0"
                    Content="+"
                    FontSize="22"
                    MinWidth="60"
                    Margin="0,0,4,0"
                    VerticalAlignment="Bottom"
                    Click="Attach_Click"/>

            <TextBox x:Name="message_tbx"
                     Grid.Column="1"
                     FontSize="22"
                     PlaceholderText="message"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     KeyUp="Message_KeyUp"/>

            <Button x:Name="send_btn"
                    Grid.Column="2"
                    Content="send"
                    Margin="4,0,0,0"
                    VerticalAlignment="Bottom"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Page>
