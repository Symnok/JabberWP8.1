<phone:PhoneApplicationPage
    x:Class="JabberWP.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,0,12">
            <TextBlock Text="JABBER" Style="{StaticResource PhoneTextNormalStyle}" Opacity="0.6"/>
            <TextBlock Text="settings" FontSize="42" Margin="9,-7,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <TextBlock Text="background" FontSize="26" Margin="4,0,0,0"/>

                <CheckBox x:Name="background_chk"
                          Content="run in the background"
                          FontSize="22"
                          Margin="0,8,0,0"
                          Checked="Background_Changed"
                          Unchecked="Background_Changed"/>

                <TextBlock TextWrapping="Wrap" FontSize="16" Opacity="0.6" Margin="16,0,0,0"
                           Text="On: the app keeps its connection when you leave it, and a background task checks for messages roughly every 30 minutes. This needs location tracking to stay running, so the location indicator stays on and the battery drains faster."/>
                <TextBlock TextWrapping="Wrap" FontSize="16" Opacity="0.6" Margin="16,10,0,0"
                           Text="Off: no location access and no background task. Messages arrive only while the app is open."/>

                <TextBlock x:Name="state_tblck" Margin="16,16,0,0" FontSize="18"
                           TextWrapping="Wrap" Opacity="0.8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
