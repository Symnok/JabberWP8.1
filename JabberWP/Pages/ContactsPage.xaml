<phone:PhoneApplicationPage
    x:Class="JabberWP.Pages.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <phone:PhoneApplicationPage.ApplicationBar>
        <!-- Menu items only, no icon buttons: an ApplicationBarIconButton needs an
             icon image, and a labelled menu entry proved easier to find anyway. -->
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="add contact" Click="AddContact_Click"/>
                <shell:ApplicationBarMenuItem Text="reconnect" Click="Reconnect_Click"/>
                <shell:ApplicationBarMenuItem Text="account" Click="Account_Click"/>
                <shell:ApplicationBarMenuItem Text="sign out" Click="SignOut_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,0,0">
            <TextBlock Text="JABBER" Style="{StaticResource PhoneTextNormalStyle}" Opacity="0.6"/>
            <TextBlock Text="contacts" FontSize="42" Margin="9,-7,0,0"/>
        </StackPanel>

        <TextBlock x:Name="state_tblck" Grid.Row="1" Margin="21,8,12,8"
                   FontSize="18" Opacity="0.7" TextWrapping="Wrap"/>

        <!-- Pending requests to see our presence, above the list so they get answered. -->
        <ItemsControl x:Name="requests_ic" Grid.Row="2" Margin="12,0,12,8" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12,10,12,10"
                            Background="{StaticResource PhoneAccentBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Text}" FontSize="20" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="accept" MinWidth="150" Click="AcceptSubscription_Click"/>
                                <Button Content="decline" MinWidth="150" Click="DeclineSubscription_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListBox x:Name="contacts_lstb" Grid.Row="3" Margin="12,0,0,0"
                 SelectionChanged="Contact_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Hold = long press. Background must be non-null or the gesture
                         is only picked up over the glyphs. -->
                    <Grid Margin="0,10,12,10" Background="Transparent" Hold="Contact_Hold">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="14" Height="14"
                                 Margin="0,10,12,0" VerticalAlignment="Top"
                                 Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="26"
                                       TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="18" Opacity="0.6"
                                       TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding LastMessage}" FontSize="18" Opacity="0.45"
                                       TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                Padding="10,3,10,3"
                                Background="{StaticResource PhoneAccentBrush}"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding UnreadText}" FontSize="18"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="empty_tblck" Grid.Row="3" Margin="21,20,12,0"
                   VerticalAlignment="Top" IsHitTestVisible="False"
                   FontSize="18" TextWrapping="Wrap" Opacity="0.6" Visibility="Collapsed"
                   Text="No contacts yet. The roster arrives from the server just after signing in. Use the menu below to add someone."/>

        <!-- Overlays: a panel rather than a dialog, so the interaction stays on one page. -->
        <Grid x:Name="rename_grid" Grid.RowSpan="4" Background="#F0000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="19,0,19,0">
                <TextBlock x:Name="renameTarget_tblck" FontSize="20" Opacity="0.7" TextWrapping="Wrap"/>
                <TextBlock Text="name" FontSize="18" Margin="0,12,0,0" Opacity="0.7"/>
                <TextBox x:Name="rename_tbx" FontSize="22"/>
                <TextBlock Text="Leave empty to go back to showing the address."
                           FontSize="16" Opacity="0.5" TextWrapping="Wrap" Margin="4,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="save" Click="RenameSave_Click" MinWidth="150"/>
                    <Button Content="cancel" Click="RenameCancel_Click" MinWidth="150"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="addContact_grid" Grid.RowSpan="4" Background="#F0000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="19,0,19,0">
                <TextBlock Text="add contact" FontSize="24"/>
                <TextBlock Text="jabber id" FontSize="18" Margin="0,12,0,0" Opacity="0.7"/>
                <TextBox x:Name="addContact_tbx" FontSize="22" InputScope="EmailSmtpAddress"/>
                <TextBlock x:Name="addContactError_tblck" FontSize="18" Margin="4,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="They have to accept before you can see whether they are online."
                           FontSize="16" Opacity="0.5" TextWrapping="Wrap" Margin="4,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="add" Click="AddContactSave_Click" MinWidth="150"/>
                    <Button Content="cancel" Click="AddContactCancel_Click" MinWidth="150"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
